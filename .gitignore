.venv/
__pycache__/
*.pyc
.env
.DS_Store
# Trace recordings are large, machine/model-specific, and change on every re-record -- kept out of git
# in general (a contract's yaml is the reviewable artifact, not the raw trace). Exception: the two
# curated example scenarios the README walks through get committed on purpose, so a fresh clone can run
# `agent-replay test vulnerable-dependency` / `customer-refund` with zero AWS. See README.md "Goldens in
# version control" and docs/DECISIONS.md. Everything else a team records for itself stays --storage aws.
# Phase 0 fix (docs/DECISIONS.md): traces now live at agent-replay/traces/, next to the contracts they
# back, not a top-level traces/ sibling -- a golden and its contract are one artifact.
agent-replay/traces/*
!agent-replay/traces/vulnerable-dependency--1.json
!agent-replay/traces/vulnerable-dependency--2.json
!agent-replay/traces/vulnerable-dependency--3.json
!agent-replay/traces/vulnerable-dependency--4.json
!agent-replay/traces/vulnerable-dependency--5.json
!agent-replay/traces/customer-refund--1.json
!agent-replay/traces/customer-refund--2.json
*.egg-info/
.pytest_cache/
.claude
dashboard-api.zip
.build/